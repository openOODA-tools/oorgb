# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oorgb-bin
_pkgname=oorgb
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal interactive color picker outputting exact hex and rgb tokens."
arch=('x86_64')
url="https://github.com/openOODA-tools/oorgb"
license=('Apache-2.0')
depends=('glibc')
provides=('oorgb')
conflicts=('oorgb')
source_x86_64=("${url}/releases/download/v${pkgver}/oorgb-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oorgb-linux-x86_64" "${pkgdir}/usr/bin/oorgb"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oorgb-uninstall"
}
